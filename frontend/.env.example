# ============================================
# Frontend Environment Variables
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your own values
# 3. NEVER commit .env to GitHub

# URL of your deployed Django backend's API root.
# Leave unset for local dev (Vite's proxy handles /api -> localhost:8000).
# REQUIRED when you build for production / deploy the frontend:
# VITE_API_URL=https://api.yourdomain.com/api

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services > Credentials).
# Must be the SAME client ID as GOOGLE_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
