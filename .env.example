# ============================================================
# Banking Management System — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================================

# --------------------------
# App Environment
# --------------------------
APP_ENV=development           # development | production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------
# PostgreSQL Database
# --------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=banking_db
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=banking_pass

# Constructed from the above (used by SQLAlchemy + Django)
DATABASE_URL=postgresql+asyncpg://banking_user:banking_pass@db:5432/banking_db
DJANGO_DATABASE_URL=postgresql://banking_user:banking_pass@db:5432/banking_db

# --------------------------
# Redis
# --------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery broker & result backend (uses Redis)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --------------------------
# JWT Authentication
# --------------------------
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------
# Django Settings
# --------------------------
DJANGO_SECRET_KEY=your-django-secret-key-change-this
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --------------------------
# Email (for Celery email tasks)
# --------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=BankingMS <no-reply@bankingms.com>

# --------------------------
# CORS (Frontend origin)
# --------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost

# --------------------------
# Logging
# --------------------------
LOG_LEVEL=DEBUG             # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/app.log
