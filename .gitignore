# ============================================
# Git Ignore — Files NOT to commit to GitHub
# ============================================
# These files contain secrets, generated code,
# or system-specific data that should NOT be shared.

# ── Python / Django ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Django
*.log
local_settings.py
db.sqlite3          # Your local database (don't commit this!)
media/
staticfiles/

# Environment variables (NEVER commit — contains passwords!)
.env
.env.local
.env.production

# ── Node.js / React ──
node_modules/       # Installed packages (huge folder, npm install recreates it)
dist/               # Production build output
.vite/

# ── OS / Editor files ──
.DS_Store           # macOS
Thumbs.db           # Windows
*.swp               # Vim
.idea/              # JetBrains IDEs
.vscode/            # VS Code settings (optional — you may want to keep this)

# ── Testing ──
.coverage
htmlcov/
.pytest_cache/

# ── Docker ──
docker-compose.override.yml
