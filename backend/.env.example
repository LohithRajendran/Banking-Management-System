# ============================================
# Environment Variables — .env file
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your own values
# 3. NEVER commit .env to GitHub (it contains secrets!)

# --- Django ---
SECRET_KEY=django-insecure-change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database Choice ---
# Set to True to use PostgreSQL instead of SQLite
# SQLite needs no setup and is perfect for local development
USE_POSTGRESQL=False

# --- PostgreSQL Settings (only needed if USE_POSTGRESQL=True) ---
DB_NAME=banking_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# --- Redis Cache (optional) ---
# Set to True only if Redis is installed on your PC
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/1
